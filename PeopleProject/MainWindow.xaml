<Window x:Class="PeopleProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeopleProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Row="0" Grid.Column="0" x:Name="lbx_people"></ListBox>
        <Label Content="Új Életkor: " Grid.Column="1" FontSize="18"/>
        <TextBox x:Name="txbx_newage" Grid.Column="1" Width="100" HorizontalAlignment="Right" Height="20" VerticalAlignment="Top" Margin="10"/>
        <Button x:Name="btn_addnew" Content="Add" Grid.Column="1" Width="100" Height="50" Click="btn_addnew_Click"/>

        <Label Content="Minimum Érték:" Grid.Column="2" FontSize="18"/>
        <TextBox x:Name="txbx_min" Grid.Column="2" Width="100" HorizontalAlignment="Center" Height="20" VerticalAlignment="Top" Margin="10"/>
        <Label Content="Maximum Érték:" Grid.Column="2" FontSize="18" Margin="0,30,0,0"/>
        <TextBox x:Name="txbx_max" Grid.Column="2" Width="100" HorizontalAlignment="Center" Height="20" VerticalAlignment="Top" Margin="0,40,0,0"/>
        <Button x:Name="btn_average" Content="Average" Grid.Column="2" Width="100" Height="50" Click="btn_average_Click"/>
        <Image x:Name="img_age" Grid.Row="1" Stretch="Fill" />
    </Grid>
</Window>
